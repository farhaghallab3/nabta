# Copy to backend/.env for local development. Do NOT commit .env.
# Every variable below is read by config/settings.py. Values here are safe
# placeholders — never put real secrets in this file.

# --- core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- database ---
# Leave unset to use local SQLite (backend/db.sqlite3).
# On Render/Railway set the managed Postgres connection string:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- CORS / CSRF (browser origins allowed to call the API) ---
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Regex allowlist — defaults to every https://*.vercel.app origin so the
# deployed frontend works without extra config. Override to lock it down:
# DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://your-app\.vercel\.app$

# --- production only (ignored when DJANGO_DEBUG=True) ---
DJANGO_SECURE_SSL_REDIRECT=True
